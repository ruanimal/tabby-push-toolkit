{
    "name": "tabby-push-toolkit",
    "version": "0.2.0",
    "description": "Push saved files and bootstrap trzsz over an existing Tabby terminal session",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ruanimal/tabby-push-toolkit.git"
    },
    "homepage": "https://github.com/ruanimal/tabby-push-toolkit#readme",
    "bugs": {
        "url": "https://github.com/ruanimal/tabby-push-toolkit/issues"
    },
    "keywords": [
        "tabby-plugin",
        "terminal",
        "trzsz"
    ],
    "main": "dist/index.js",
    "types": "typings/index.d.ts",
    "files": [
        "dist",
        "typings",
        "scripts"
    ],
    "author": "ruanimal",
    "license": "MIT",
    "scripts": {
        "build": "tsc --emitDeclarationOnly && webpack --mode production",
        "watch": "webpack --mode development --watch",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "prepack": "pnpm run build"
    },
    "dependencies": {
        "tar-stream": "^3.2.2"
    },
    "peerDependencies": {
        "@angular/common": "^15",
        "@angular/core": "^15",
        "@angular/forms": "^15",
        "rxjs": "^7",
        "tabby-core": "*",
        "tabby-electron": "*",
        "tabby-settings": "*",
        "tabby-terminal": "*",
        "tabby-trzsz": "^1.0.7"
    },
    "devDependencies": {
        "@angular/common": "15.2.10",
        "@angular/compiler": "15.2.10",
        "@angular/compiler-cli": "15.2.10",
        "@angular/core": "15.2.10",
        "@angular/forms": "15.2.10",
        "@ngtools/webpack": "15.2.11",
        "@types/node": "^20.3.1",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "babel-loader": "^10.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "prettier": "^3.9.6",
        "rxjs": "^7.8.0",
        "tabby-core": "1.0.231-nightly.0",
        "tabby-electron": "1.0.231-nightly.0",
        "tabby-settings": "1.0.231-nightly.0",
        "tabby-terminal": "1.0.231-nightly.0",
        "tabby-trzsz": "1.0.7",
        "trzsz": "1.1.6",
        "typescript": "^4.9.5",
        "vitest": "^4.1.10",
        "webpack": "^5.86.0",
        "webpack-cli": "^5.0.1"
    }
}
